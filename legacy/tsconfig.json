{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,

    // Node 24 runs .ts directly and does not rewrite specifiers, so imports
    // carry the real .ts extension. Nothing here emits: the runtime is Node
    // for source and esbuild for the vendored bundle, and tsc only typechecks.
    "allowImportingTsExtensions": true,

    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"]
}
